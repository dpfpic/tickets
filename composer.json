{
    "name": "dpfpic/tickets",
    "description": "Simple request desk managed by a dedicated group",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "autoload": {
        "psr-4": {
            "OCA\\Tickets\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\Tickets\\Tests\\": "tests/Unit/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1"
        }
    },
    "scripts": {
        "test:unit": "phpunit -c phpunit.xml"
    }
}
